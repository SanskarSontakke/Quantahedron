  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/katex": "^0.16.7",
    "@types/node": "^22.19.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.187.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "15.5.29",
    "prettier": "^3.6.2",
